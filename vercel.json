{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/beast-of-reincarnation",
      "destination": "/beast-of-reincarnation/en",
      "permanent": false
    },
    {
      "source": "/beast-of-reincarnation/bosses",
      "destination": "/beast-of-reincarnation/en/bosses",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/builds",
      "destination": "/beast-of-reincarnation/en/builds",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/koo-guide",
      "destination": "/beast-of-reincarnation/en/koo-guide",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/beginner-guide",
      "destination": "/beast-of-reincarnation/en/beginner-guide",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/release-date",
      "destination": "/beast-of-reincarnation/en/release-date",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/faq",
      "destination": "/beast-of-reincarnation/en/faq",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/review",
      "destination": "/beast-of-reincarnation/en/review",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/metacritic",
      "destination": "/beast-of-reincarnation/en/metacritic",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/how-long-to-beat",
      "destination": "/beast-of-reincarnation/en/how-long-to-beat",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/walkthrough",
      "destination": "/beast-of-reincarnation/en/walkthrough",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/all-weapons",
      "destination": "/beast-of-reincarnation/en/all-weapons",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/all-endings",
      "destination": "/beast-of-reincarnation/en/all-endings",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/trophies",
      "destination": "/beast-of-reincarnation/en/trophies",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/pc-requirements",
      "destination": "/beast-of-reincarnation/en/pc-requirements",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/performance",
      "destination": "/beast-of-reincarnation/en/performance",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/editions",
      "destination": "/beast-of-reincarnation/en/editions",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/release-time",
      "destination": "/beast-of-reincarnation/en/release-time",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/release-time",
      "destination": "/beast-of-reincarnation/en/release-date",
      "permanent": true
    },
    {
      "source": "/beast-of-reincarnation/:lang(en|de|es|fr|it|ja)/release-time",
      "destination": "/beast-of-reincarnation/:lang/release-date",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|jpg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
